production=true
# sharp (dependencia de Baileys para thumbnails) trae binarios nativos que
# crashean con "illegal instruction" en CPUs viejas (netbooks/Atom) sin que
# ningún try/catch de JS lo pueda atrapar. Se desactiva el auto-install de
# peer deps para que no se instale, y se agrega jimp (puro JS) como
# reemplazo explícito más abajo en package.json.
auto-install-peers=false
